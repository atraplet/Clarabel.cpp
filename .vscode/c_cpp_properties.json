{
    "configurations": [
        {
            "name": "Linux",
            // Use the flags CMake actually compiles the examples/tests with
            // (requires a configured build in `build/`, see README).
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            // Fallback for files not in compile_commands.json, e.g. headers
            // such as examples/c/utils.h and examples/cpp/utils.h.
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/examples/c",
                "${workspaceFolder}/examples/cpp",
                "${workspaceFolder}/tests",
                "/usr/include/eigen3"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "linux-gcc-x64",
            "browse": {
                "path": [
                    "${workspaceFolder}/include",
                    "${workspaceFolder}/examples",
                    "${workspaceFolder}/tests"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            }
        }
    ],
    "version": 4
}
